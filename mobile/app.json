{
  "expo": {
    "name": "mooni",
    "slug": "mooni",
    "scheme": "mooni",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111318"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mooni.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.mooni.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#111318"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow camera access to scan the pairing QR code from the backend.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": [
            "image/*",
            "video/*"
          ],
          "androidMultiIntentFilters": [
            "image/*",
            "video/*"
          ]
        }
      ],
      "./plugins/withPlayCompat",
      "./plugins/withGradleMem",
      "./plugins/withSkipReleaseLint",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "dc4c86de-3bf4-4b13-9263-654991d4460b"
      }
    },
    "owner": "mooni-app"
  }
}
